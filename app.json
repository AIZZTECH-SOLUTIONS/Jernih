{
  "expo": {
    "name": "Jernih",
    "slug": "jernih",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jernih",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aizztech.jernih",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Pick photos and videos to optimize for WhatsApp Status.",
        "NSPhotoLibraryAddUsageDescription": "Save optimized media to your photo library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aizztech.jernih",
      "adaptiveIcon": {
        "backgroundColor": "#0b141a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b141a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick photos and videos to optimize for WhatsApp Status.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Save optimized media to your photo library.",
          "savePhotosPermission": "Save optimized media to your photo library.",
          "granularPermissions": ["photo", "video"]
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f1955b6-6861-4912-867c-94c06d4c4777"
      }
    },
    "owner": "syahrulsss"
  }
}
